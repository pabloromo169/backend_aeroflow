table D7_aviones_repetidos_dia

	column simulation_id
		dataType: string
		summarizeBy: none
		sourceColumn: simulation_id

	column aircraft_id
		dataType: string
		summarizeBy: none
		sourceColumn: aircraft_id

	column scheduled_local_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: scheduled_local_date

	column operations
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: operations

	column over_threshold_departures
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: over_threshold_departures

	column max_minutes_over
		dataType: double
		formatString: #,##0.00
		summarizeBy: none
		sourceColumn: max_minutes_over

	partition D7_aviones_repetidos_dia = m
		mode: directQuery
		source =
			let
				Origen = Dremio.DatabasesV370("adbc://192.168.0.26:32010", "Disabled"),
				Aeroflow = Origen{[Name="Aeroflow",Kind="Schema"]}[Data],
				Vista = Aeroflow{[Name="D7_aviones_repetidos_dia",Kind="Table"]}[Data]
			in
				Vista
