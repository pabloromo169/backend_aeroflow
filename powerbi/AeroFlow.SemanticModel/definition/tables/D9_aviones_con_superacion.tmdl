table D9_aviones_con_superacion

	/// Salidas válidas de la simulación SIM-01. Vista D9 de Dremio.
	measure 'D9 aviones con superacion' = CALCULATE(SUM(D9_aviones_con_superacion[valid_departures]), D9_aviones_con_superacion[simulation_id] = "SIM-01")
		formatString: #,##0

	column simulation_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: simulation_id

	column valid_departures
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: valid_departures

	column over_threshold_departures
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: over_threshold_departures

	column pct_departures_over_threshold
		dataType: double
		summarizeBy: none
		sourceColumn: pct_departures_over_threshold

	partition D9_aviones_con_superacion = m
		mode: directQuery
		source =
			let
				Origen = Dremio.DatabasesV370("192.168.0.26:32010", "Disabled"),
				Aeroflow = Origen{[Name="Aeroflow",Kind="Schema"]}[Data],
				Vista = Aeroflow{[Name="D9_aviones_con_superacion",Kind="Table"]}[Data]
			in
				Vista
