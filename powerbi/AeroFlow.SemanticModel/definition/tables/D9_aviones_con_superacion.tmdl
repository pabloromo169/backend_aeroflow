table D9_aviones_con_superacion

	column simulation_id
		dataType: string
		summarizeBy: none
		sourceColumn: simulation_id

	column valid_departures
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: valid_departures

	column distinct_aircraft
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: distinct_aircraft

	column aircraft_with_exceedance
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: aircraft_with_exceedance

	column over_threshold_departures
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: over_threshold_departures

	column pct_aircraft_with_exceedance
		dataType: double
		formatString: #,##0.0"%"
		summarizeBy: none
		sourceColumn: pct_aircraft_with_exceedance

	column pct_departures_over_threshold
		dataType: double
		formatString: #,##0.0"%"
		summarizeBy: none
		sourceColumn: pct_departures_over_threshold

	partition D9_aviones_con_superacion = m
		mode: directQuery
		source =
			let
				Origen = Dremio.DatabasesV370("adbc://192.168.0.26:32010", "Disabled"),
				Aeroflow = Origen{[Name="Aeroflow",Kind="Schema"]}[Data],
				Vista = Aeroflow{[Name="D9_aviones_con_superacion",Kind="Table"]}[Data]
			in
				Vista
