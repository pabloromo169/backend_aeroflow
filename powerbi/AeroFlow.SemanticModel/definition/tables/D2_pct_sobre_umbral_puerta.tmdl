table D2_pct_sobre_umbral_puerta

	column simulation_id
		dataType: string
		summarizeBy: none
		sourceColumn: simulation_id

	column gate_id
		dataType: string
		summarizeBy: none
		sourceColumn: gate_id

	column terminal_id
		dataType: string
		summarizeBy: none
		sourceColumn: terminal_id

	column gate_threshold
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: gate_threshold

	column valid_departures
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: valid_departures

	column over_threshold
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: over_threshold

	column pct_over_threshold
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: pct_over_threshold

	partition D2_pct_sobre_umbral_puerta = m
		mode: directQuery
		source =
			let
				Origen = Dremio.DatabasesV370("adbc://192.168.0.26:32010", "Disabled"),
				Aeroflow = Origen{[Name="Aeroflow",Kind="Schema"]}[Data],
				Vista = Aeroflow{[Name="D2_pct_sobre_umbral_puerta",Kind="Table"]}[Data]
