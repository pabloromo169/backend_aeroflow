table D10_salidas_detalle
	lineageTag: {90225c79-563c-5160-9596-72f19b8640e9}

	column simulation_id
		dataType: string
		summarizeBy: none
		sourceColumn: simulation_id

	column event_id
		dataType: string
		summarizeBy: none
		sourceColumn: event_id

	column scheduled_local_date
		dataType: dateTime
		formatString: dd/MM
		summarizeBy: none
		sourceColumn: scheduled_local_date

	column day_type
		dataType: string
		summarizeBy: none
		sourceColumn: day_type

	column time_band
		dataType: string
		summarizeBy: none
		sourceColumn: time_band
		sortByColumn: time_band_orden

	column time_band_orden
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: time_band_orden

	column salidas
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: salidas

	column supera_umbral
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: supera_umbral

	column pct_superacion
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: pct_superacion

	partition D10_salidas_detalle = m
		mode: directQuery
		source =
			let
				Origen = Dremio.DatabasesV370("adbc://192.168.0.26:32010", "Disabled"),
				Aeroflow = Origen{[Name="Aeroflow",Kind="Schema"]}[Data],
				Vista = Aeroflow{[Name="D10_salidas_detalle",Kind="Table"]}[Data]
			in
				Vista
