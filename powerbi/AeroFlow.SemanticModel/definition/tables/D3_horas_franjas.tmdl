table D3_horas_franjas

	column simulation_id
		dataType: string
		summarizeBy: none
		sourceColumn: simulation_id

	column gate_id
		dataType: string
		summarizeBy: none
		sourceColumn: gate_id

	column local_hour
		dataType: int64
		summarizeBy: none
		sourceColumn: local_hour

	column time_band
		dataType: string
		summarizeBy: none
		sourceColumn: time_band

	column valid_departures
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: valid_departures

	column over_threshold
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: over_threshold

	column pct_over_threshold
		dataType: double
		formatString: #,##0.00
		summarizeBy: none
		sourceColumn: pct_over_threshold

	partition D3_horas_franjas = m
		mode: directQuery
		source =
			let
				Origen = Dremio.DatabasesV370("adbc://192.168.0.26:32010", "Disabled"),
				Aeroflow = Origen{[Name="Aeroflow",Kind="Schema"]}[Data],
				Vista = Aeroflow{[Name="D3_horas_franjas",Kind="Table"]}[Data]
			in
				Vista
