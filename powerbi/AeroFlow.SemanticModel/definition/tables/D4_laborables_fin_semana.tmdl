table D4_laborables_fin_semana

	column simulation_id
		dataType: string
		summarizeBy: none
		sourceColumn: simulation_id

	column day_type
		dataType: string
		summarizeBy: none
		sourceColumn: day_type
		sortByColumn: day_type_orden

	column day_type_orden
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: day_type_orden

	column valid_departures
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: valid_departures

	column days_included
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: days_included

	column avg_departures_per_day
		dataType: double
		formatString: #,##0.0
		summarizeBy: none
		sourceColumn: avg_departures_per_day

	column distinct_aircraft
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: distinct_aircraft

	column over_threshold
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: over_threshold

	column pct_over_threshold
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: pct_over_threshold

	column pct_of_total
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: pct_of_total

	partition D4_laborables_fin_semana = m
		mode: directQuery
		source =
			let
				Origen = Dremio.DatabasesV370("adbc://192.168.0.26:32010", "Disabled"),
				Aeroflow = Origen{[Name="Aeroflow",Kind="Schema"]}[Data],
				Vista = Aeroflow{[Name="D4_laborables_fin_semana",Kind="Table"]}[Data]
			in
				Vista
