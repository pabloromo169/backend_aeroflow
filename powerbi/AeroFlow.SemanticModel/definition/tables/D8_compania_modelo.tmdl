table D8_compania_modelo

	column simulation_id
		dataType: string
		summarizeBy: none
		sourceColumn: simulation_id

	column airline
		dataType: string
		summarizeBy: none
		sourceColumn: airline

	column aircraft_model
		dataType: string
		summarizeBy: none
		sourceColumn: aircraft_model

	column valid_departures
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: valid_departures

	column over_threshold
		dataType: int64
		formatString: #,##0
		summarizeBy: sum
		sourceColumn: over_threshold

	column pct_over_threshold
		dataType: double
		formatString: #,##0.00
		summarizeBy: none
		sourceColumn: pct_over_threshold

	column meets_minimum
		dataType: boolean
		summarizeBy: none
		sourceColumn: meets_minimum

	partition D8_compania_modelo = m
		mode: directQuery
		source =
			let
				Origen = Dremio.DatabasesV370("adbc://192.168.0.26:32010", "Disabled"),
				Aeroflow = Origen{[Name="Aeroflow",Kind="Schema"]}[Data],
				Vista = Aeroflow{[Name="D8_compania_modelo",Kind="Table"]}[Data]
			in
				Vista
