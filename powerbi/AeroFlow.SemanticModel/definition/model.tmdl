relationship D_SIMULACIONES__D1_salidas_por_puerta_destino
	fromCardinality: one
	fromColumn: D_SIMULACIONES.simulation_id
	toColumn: D1_salidas_por_puerta_destino.simulation_id
	toCardinality: many
	crossFilteringBehavior: bothDirections

